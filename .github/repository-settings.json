{
  "default_branch": "main",
  "features": {
    "discussions": true,
    "delete_branch_on_merge": true,
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false
  },
  "metadata": {
    "homepage": "https://ramazankara.github.io/agentworkflows/",
    "topics": [
      "agent-workflows",
      "kubernetes",
      "llm",
      "rag",
      "ai-agents",
      "gitops",
      "vllm",
      "ollama",
      "platform-engineering",
      "open-source",
      "llm-gateway",
      "ai-gateway",
      "openai-compatible",
      "anthropic",
      "cloud-ai",
      "coding-agents",
      "audit-log",
      "ai-governance",
      "helm",
      "docker-compose"
    ]
  },
  "security": {
    "private_vulnerability_reporting": true,
    "vulnerability_alerts": true,
    "automated_security_fixes": true,
    "secret_scanning": true,
    "secret_scanning_push_protection": true
  },
  "branch_protection": {
    "required_status_checks": [],
    "strict": true,
    "required_approving_review_count": 1,
    "dismiss_stale_reviews": true,
    "require_conversation_resolution": true,
    "_enforce_admins_note": "False by design. GitHub blocks approving your own pull request, so required_approving_review_count with a sole maintainer is unsatisfiable; with enforce_admins on, every release required temporarily disabling a branch-protection control, which made the bypass routine. Review stays required for contributors; the maintainer can self-merge. CI runs after pushes to main or manual dispatch, so pull requests have no required status checks.",
    "enforce_admins": false,
    "allow_force_pushes": false,
    "allow_deletions": false
  },
  "environments": {
    "pypi": {
      "reviewers": ["RamazanKara"],
      "prevent_self_review": false,
      "deployment_policies": [
        {"name": "v*", "type": "tag"}
      ]
    },
    "github-pages": {
      "reviewers": [],
      "prevent_self_review": false,
      "deployment_policies": [
        {"name": "main", "type": "branch"},
        {"name": "gh-pages", "type": "branch"},
        {"name": "v*", "type": "tag"}
      ]
    }
  }
}
