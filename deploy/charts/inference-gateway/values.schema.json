{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "inference-gateway values",
  "type": "object",
  "properties": {
    "storage": {
      "type": "object",
      "properties": {
        "backend": { "type": "string", "enum": ["redis", "postgres"] },
        "postgres": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "key": { "type": "string", "minLength": 1 }
              }
            },
            "poolSize": { "type": "integer", "minimum": 1 },
            "timeoutSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
            "bundled": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "image": { "type": "string", "minLength": 1 },
                "storage": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "traceability": {
      "type": "object",
      "properties": {
        "auditViewRetentionSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "antiAffinity": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        }
      },
      "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
      "then": {
        "properties": {
          "host": { "minLength": 1, "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$" },
          "tls": {
            "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
            "then": { "properties": { "secretName": { "minLength": 1 } }, "required": ["secretName"] }
          }
        },
        "required": ["host"]
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "oidc": {
          "type": "object",
          "properties": {
            "issuer": { "type": "string" },
            "clientId": { "type": "string" },
            "clientSecret": { "type": "string" },
            "existingSecret": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "key": { "type": "string", "minLength": 1 }
              }
            },
            "redirectUrl": { "type": "string" },
            "scopes": { "type": "string", "pattern": "(^| )openid( |$)" },
            "teamClaim": { "type": "string" },
            "roleClaim": { "type": "string" },
            "projectClaim": { "type": "string" },
            "defaultRole": { "enum": ["admin", "builder", "approver", "viewer"] }
          }
        }
      }
    },
    "deployment": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodePort": { "type": ["integer", "null"], "minimum": 30000, "maximum": 32767 }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "backend": { "type": "string", "enum": ["ollama", "vllm"] }
      }
    },
    "providerCredentials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["env", "secretName", "secretKey"],
        "properties": {
          "env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
          "secretName": { "type": "string", "minLength": 1 },
          "secretKey": { "type": "string", "minLength": 1 }
        }
      }
    },
    "admission": {
      "type": "object",
      "properties": {
        "maxMessages": { "type": "integer", "minimum": 1 },
        "maxPromptChars": { "type": "integer", "minimum": 1 },
        "maxRequestBodyBytes": { "type": "integer", "minimum": 1 },
        "maxCompletionTokens": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
