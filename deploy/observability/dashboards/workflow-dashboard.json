  "panels": [
    {
      "id": 1,
      "title": "Governed calls per second",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (sandbox, backend) (rate(inference_gateway_sandbox_requests_total[5m]))",
          "refId": "A",
          "legendFormat": "{{sandbox}} / {{backend}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Failed calls per second",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (sandbox) (rate(inference_gateway_sandbox_requests_total{status=~\"4..|5..\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{sandbox}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
